# Database Configuration (MySQL / MariaDB via XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zero_trust_security
DB_USER=root
DB_PASSWORD=

# Services Port Configuration
GATEWAY_PORT=3000
NILAI_PORT=3001
TRANSKRIP_PORT=3002

# Internal Services URLs (from Gateway perspective)
NILAI_SERVICE_URL=http://127.0.0.1:3001
TRANSKRIP_SERVICE_URL=http://127.0.0.1:3002
GATEWAY_URL=http://127.0.0.1:3000

# Security Secrets (Ganti dengan string acak dan aman)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long_super_safe
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long_super_safe
JWT_SERVICE_SECRET=your_jwt_service_secret_key_minimum_32_characters_long_super_safe
GATEWAY_SECRET=gateway_internal_secret_header_key_change_in_production_xyz123

# Service Client Credentials (for Service-to-Service Authentication)
SERVICE_NILAI_CLIENT_ID=service-nilai
SERVICE_NILAI_CLIENT_SECRET=secret-credential-for-nilai-service-sync-2026

# Token Lifetime Configuration
ACCESS_TOKEN_EXPIRES_IN=10m
REFRESH_TOKEN_EXPIRES_IN=1d
SERVICE_TOKEN_EXPIRES_IN=5m

# Time-based Access Policy (WIB)
ACCESS_START_HOUR=7
ACCESS_END_HOUR=21
TIME_ZONE=Asia/Jakarta
