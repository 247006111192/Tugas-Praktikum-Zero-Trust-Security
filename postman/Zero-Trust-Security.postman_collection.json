        {
          "name": "4.4 Mahasiswa Melihat Transkrip Sendiri (GET /transkrip/:nim)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Device-ID",
                "value": "{{deviceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transkrip/{{transcriptNim}}",
              "host": ["{{baseUrl}}"],
              "path": ["transkrip", "{{transcriptNim}}"]
            }
          }
        },
        {
          "name": "4.5 Mahasiswa Ditolak Melihat Transkrip Lain (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Device-ID",
                "value": "{{deviceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transkrip/2021002",
              "host": ["{{baseUrl}}"],
              "path": ["transkrip", "2021002"]
            }
          }
        },
        {
          "name": "4.6 Sinkronisasi Transkrip Menggunakan Service Token (200 OK)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{serviceToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classId\": 1,\n  \"items\": [\n    {\n      \"student_id\": 4,\n      \"score\": 88.5,\n      \"source_grade_id\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transkrip/sinkron",
              "host": ["{{baseUrl}}"],
              "path": ["transkrip", "sinkron"]
            }
          }
        },
        {
          "name": "4.7 User Access Token Ditolak pada Sinkronisasi (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Device-ID",
                "value": "{{deviceId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classId\": 1,\n  \"items\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transkrip/sinkron",
              "host": ["{{baseUrl}}"],
              "path": ["transkrip", "sinkron"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Audit Logs",
      "item": [
        {
          "name": "5.1 Melihat Audit Log (Hanya Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Device-ID",
                "value": "{{deviceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/audit-logs?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["audit-logs"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
