{
  "name": "zero-trust-security",
  "version": "1.0.0",
  "description": "Zero Trust Security untuk Sistem Layanan Nilai Akademik",
  "main": "src/gateway/server.js",
  "scripts": {
    "start:gateway": "node src/gateway/server.js",
    "start:nilai": "node src/services/nilai/server.js",
    "start:transkrip": "node src/services/transkrip/server.js",
    "start": "node scripts/start-all.js",
    "db:setup": "node scripts/setup-database.js",
    "db:test": "node scripts/test-database.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [
    "zero-trust",
    "express",
    "mysql",
    "jwt",
    "security",
    "gateway"
  ],
  "author": "Mahasiswa Keamanan Informasi",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
